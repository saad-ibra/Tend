{
  "$comment": "Tend Prototype — Complete JSON Schemas & Seed/Dummy Data Fixtures",
  "version": "1.5.1",
  "schemas": {
    "AiCoachPromptResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AiCoachPromptResponse",
      "description": "Structured JSON contract returned by Groq Cloud and Google Gemini models",
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string",
          "description": "Conversational, empathetic, grounded answer providing clear observations and actionable guidance."
        },
        "weekly_summary": {
          "type": "object",
          "properties": {
            "completion_rate": {
              "type": "string",
              "description": "Percentage string (e.g. 80%)"
            },
            "highlight": {
              "type": "string",
              "description": "Key consistency achievement or strength observed"
            },
            "growth_area": {
              "type": "string",
              "description": "A gentle improvement focus or friction point"
            }
          }
        },
        "suggested_action": {
          "type": "object",
          "required": ["type", "title"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["create_habit", "modify_habit", "none"]
            },
            "target_habit_id": {
              "type": ["string", "null"],
              "description": "Existing habit ID if modifying, otherwise null"
            },
            "title": {
              "type": "string",
              "description": "Title of the new or modified rhythm"
            },
            "description": {
              "type": ["string", "null"],
              "description": "Short intention or reminder (under 60 chars)"
            },
            "frequency_type": {
              "type": "string",
              "enum": ["daily", "weekdays"]
            },
            "target_weekdays": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1, "maximum": 7 }
            },
            "color_hex": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "reason": {
              "type": "string",
              "description": "Clear explanation of why this action is suggested based on data"
            }
          }
        }
      }
    },
    "CoachSession": {
      "title": "CoachSession",
      "type": "object",
      "required": ["id", "title", "created_at", "updated_at", "messages"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "is_pinned": { "type": "boolean", "default": false },
        "is_archived": { "type": "boolean", "default": false },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/schemas/CoachMessage" }
        }
      }
    },
    "CoachMessage": {
      "title": "CoachMessage",
      "type": "object",
      "required": ["id", "sender", "text", "timestamp"],
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "coach"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "action": { "$ref": "#/schemas/CoachAction" },
        "metrics_summary": { "type": "object" }
      }
    },
    "CoachAction": {
      "title": "CoachAction",
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["createHabit", "modifyHabit", "none"] },
        "target_habit_id": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "frequency_type": { "type": "string", "enum": ["daily", "weekdays"] },
        "target_weekdays": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "color_hex": { "type": "string" },
        "reason": { "type": "string" },
        "is_executed": { "type": "boolean", "default": false },
        "is_dismissed": { "type": "boolean", "default": false }
      }
    },
    "Habit": {
      "title": "Habit",
      "type": "object",
      "required": ["id", "title", "frequencyType", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "frequencyType": { "type": "string", "enum": ["daily", "weekdays"] },
        "targetWeekdays": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "colorHex": { "type": "string" },
        "isArchived": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "HabitCompletion": {
      "title": "HabitCompletion",
      "type": "object",
      "required": ["id", "habitId", "completedDate", "timestamp"],
      "properties": {
        "id": { "type": "string" },
        "habitId": { "type": "string" },
        "completedDate": { "type": "string", "format": "date-time" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "MoodEnergyCheckIn": {
      "title": "MoodEnergyCheckIn",
      "type": "object",
      "required": ["id", "date", "moodScore", "energyScore"],
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "moodScore": { "type": "integer", "minimum": 1, "maximum": 5 },
        "energyScore": { "type": "integer", "minimum": 1, "maximum": 5 },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "FeedArticle": {
      "title": "FeedArticle",
      "type": "object",
      "required": ["id", "title", "excerpt", "content", "author", "authorRole", "category", "readTimeMinutes", "publishedAt"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "authorRole": { "type": "string" },
        "category": { "type": "string", "enum": ["Stillness", "Rhythm", "Focus", "Rest"] },
        "readTimeMinutes": { "type": "integer" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "isBookmarked": { "type": "boolean", "default": false }
      }
    },
    "RhythmCircle": {
      "title": "RhythmCircle",
      "type": "object",
      "required": ["id", "name", "philosophy", "category", "rhythmFocus", "memberCount", "weeklyConsistencyPercent", "createdAt", "members"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "philosophy": { "type": "string" },
        "category": { "type": "string", "enum": ["Morning", "Focus", "Rest", "Creative"] },
        "rhythmFocus": { "type": "string" },
        "memberCount": { "type": "integer" },
        "weeklyConsistencyPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "isJoined": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "avatarInitial", "currentRhythm", "tendedToday", "streakDays"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "avatarInitial": { "type": "string" },
              "currentRhythm": { "type": "string" },
              "tendedToday": { "type": "boolean" },
              "streakDays": { "type": "integer" }
            }
          }
        }
      }
    }
  },
